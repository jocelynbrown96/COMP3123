{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run index.js in Terminal",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/index.js",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Run object_examples.js in Terminal",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/object_examples.js",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "name": "Launch Edge",
            "request": "launch",
            "type": "msedge",
            "url": "http://127.0.0.1:8080/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Edge - object_examples.js",
            "request": "launch",
            "type": "msedge",
            "url": "http://127.0.0.1:8080/object_examples.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Open in Integrated Browser",
            "request": "launch",
            "type": "msedge",
            "url": "http://127.0.0.1:8080/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach to Edge",
            "port": 9222,
            "request": "attach",
            "type": "msedge",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome against localhost",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        }
    ]
}